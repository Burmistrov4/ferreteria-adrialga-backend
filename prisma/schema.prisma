generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categorias {
  Categoria_ID   Int         @id @default(autoincrement())
  Nombre         String      @db.VarChar(100)
  Prefijo_SKU    String      @default("GEN") @db.VarChar(30)
  // Margen sugerido en % por defecto para productos nuevos de la categoría
  // (raíz de la cascada: Variante → Producto → Categoría).
  Margen_Sugerido Decimal?   @db.Decimal(18, 6)
  Descripcion    String?     @db.VarChar(255)
  Activo         Boolean     @default(true)
  Fecha_Registro DateTime    @default(now()) @db.Timestamp(0)
  // ── B1: jerarquía auto-referencial (subcategorías, N niveles) ──
  // null = categoría raíz. El producto.Categoria_ID apunta siempre a la HOJA.
  Categoria_Padre_ID Int?
  padre              categorias? @relation("CatHijas", fields: [Categoria_Padre_ID], references: [Categoria_ID], map: "FK_Cat_Padre")
  hijas              categorias[] @relation("CatHijas")
  productos      productos[]
}

model clientes {
  Cliente_ID     Int        @id @default(autoincrement())
  RIF_Cedula     String     @unique(map: "RIF_Cedula") @db.VarChar(20)
  Tipo_Documento String     @default("V") @db.VarChar(1)
  Num_Documento  String     @default("") @db.VarChar(20)
  Razon_Social   String     @db.VarChar(150)
  Direccion      String?    @db.VarChar(255)
  Telefono       String?    @db.VarChar(20)
  Email          String?    @db.VarChar(100)
  Fecha_Registro DateTime   @default(now()) @db.Timestamp(0)
  facturas       facturas[]

  @@index([Num_Documento], map: "IDX_Clientes_NumDocumento")
  @@index([Razon_Social], map: "IDX_Clientes_RazonSocial")
}

model proveedores {
  Proveedor_ID          Int                     @id @default(autoincrement())
  RIF_Cedula            String                  @unique(map: "RIF_Cedula") @db.VarChar(20)
  Razon_Social          String                  @db.VarChar(150)
  Telefono              String?                 @db.VarChar(20)
  Email                 String?                 @db.VarChar(100)
  Direccion             String?                 @db.VarChar(255)
  Activo                Boolean                 @default(true)
  Fecha_Registro        DateTime                @default(now()) @db.Timestamp(0)
  notas_entrega_entrada notas_entrega_entrada[]
  cuentas_por_pagar     cuentas_por_pagar[]
}

model productos {
  Producto_ID           Int                     @id @default(autoincrement())
  SKU_Codigo            String                  @unique(map: "SKU_Codigo") @db.VarChar(50)
  Nombre                String                  @db.VarChar(150)
  Precio_Venta          Decimal                 @default(0.0000) @db.Decimal(18, 6)
  Costo_Promedio        Decimal                 @default(0.0000) @db.Decimal(18, 6)
  /// Margen bruto configurado en % sobre el costo (ej. 25 = 25%).
  /// Precio_Venta = Costo_Ultimo * (1 + Margen_Ganancia/100) cuando ambos se envían.
  Margen_Ganancia       Decimal                 @default(0.0000) @db.Decimal(18, 6)
  /// Último costo de compra registrado (base del cálculo de precio sugerido).
  Costo_Ultimo           Decimal                 @default(0.0000) @db.Decimal(18, 6)
  /// URL opcional de imagen (para previsualización en POS y tickets).
  Imagen_URL             String?                 @db.VarChar(500)
  Stock_Actual          Int                     @default(0)
  Stock_Minimo          Int                     @default(5)
  // ── B1: trazabilidad del catálogo EPA (scraper) ──
  // Código único del proveedor EPA (ej. VE-1003591). Clave de upsert idempotente.
  Codigo_EPA            String?                 @db.VarChar(50) @unique(map: "UQ_Codigo_EPA")
  // Marca/fabricante extraída del JSON-LD (ej. "Inca", "Duncan").
  Marca                 String?                 @db.VarChar(100)
  // Precio base de referencia en USD (JSON-LD price). El TPV convierte a Bs
  // dinámicamente con la tasa BCV activa (tasas_bcv).
  Precio_Ref_USD        Decimal?                @db.Decimal(18, 6)
  Categoria_ID          Int
  Activo                Boolean                 @default(true)
  Fecha_Registro        DateTime                @default(now()) @db.Timestamp(0)
  detalle_facturas      detalle_facturas[]
  detalle_notas_entrega detalle_notas_entrega[]
  producto_variantes    producto_variantes[]
  categorias            categorias              @relation(fields: [Categoria_ID], references: [Categoria_ID], map: "FK_Productos_Categorias")

  @@index([Categoria_ID], map: "IDX_Productos_Categoria")
}

model usuarios {
  Usuario_ID            Int        @id @default(autoincrement())
  Nombre                String     @db.VarChar(180)
  Credencial            String     @unique(map: "Credencial") @db.VarChar(50)
  Password              String     @db.VarChar(255)
  // Rol de acceso: CAJERO | SUPERVISOR | ADMIN (default Cajero).
  Rol                   RolUsuario @default(CAJERO)
  // PIN de operación (4-6 dígitos) para autorización en caliente de acciones
  // críticas (reversión de ventas, ajustes de inventario). Solo lo poseen
  // perfiles SUPERVISOR/ADMIN.
  PIN_Operaciones       String?    @db.VarChar(60)
  Activo                Boolean    @default(true)
  Fecha_Registro        DateTime   @default(now()) @db.Timestamp(0)
  facturas              facturas[]
  notas_entrega_entrada notas_entrega_entrada[]
  autorizaciones        facturas[] @relation("AutorizadoPor")
  caja                  caja[]
  movimientos_caja      movimientos_caja[]

  @@index([Rol], map: "IDX_Usuarios_Rol")
}

model facturas {
  Factura_ID          Int                @id @default(autoincrement())
  Numero_Control      String?            @unique(map: "Numero_Control") @db.VarChar(50)
  Fecha_Emision       DateTime           @default(now()) @db.Timestamp(0)
  Subtotal            Decimal                 @default(0.0000) @db.Decimal(18, 6)
  Total_IVA           Decimal                 @default(0.0000) @db.Decimal(18, 6)
  Total_General       Decimal                 @default(0.0000) @db.Decimal(18, 6)
  // Tasa BCV histórica obligatoria usada al momento de la emisión (4 decimales).
  // Default temporal 1.0 para sincronización con Railway (rellena filas existentes).
  Tasa_Cambio         Decimal            @default(1.0) @db.Decimal(18, 6)
  Monto_IGTF          Decimal                 @default(0.0000) @db.Decimal(18, 6)
  Estatus             String             @default("Completada") @db.VarChar(20)
  // Tipo de comprobante fiscal: FACTURA | NOTA_CREDITO (P0.4).
  Tipo_Documento      String?            @default("FACTURA") @db.VarChar(20)
  // Para NOTA_CREDITO apunta al Factura_ID original afectado.
  Factura_Afectada_ID Int?
  // Supervisor/Admin que autorizó con PIN una acción crítica (reversión).
  Autorizado_Por_ID   Int?
  Cliente_ID          Int
  Usuario_ID          Int
  detalle_facturas    detalle_facturas[]
  clientes            clientes           @relation(fields: [Cliente_ID], references: [Cliente_ID], map: "FK_Facturas_Clientes")
  usuarios            usuarios           @relation(fields: [Usuario_ID], references: [Usuario_ID], map: "FK_Facturas_Usuarios")
  autorizadoPor       usuarios?          @relation("AutorizadoPor", fields: [Autorizado_Por_ID], references: [Usuario_ID], map: "FK_Facturas_AutorizadoPor")
  pagos               pagos[]

  @@index([Cliente_ID], map: "FK_Facturas_Clientes")
  @@index([Usuario_ID], map: "FK_Facturas_Usuarios")
  @@index([Fecha_Emision], map: "IDX_Facturas_Fecha")
  @@index([Tipo_Documento], map: "IDX_Facturas_TipoDoc")
  @@index([Factura_Afectada_ID], map: "IDX_Facturas_Afectada")
  @@index([Autorizado_Por_ID], map: "IDX_Facturas_Autorizado")
}

model detalle_facturas {
  Detalle_ID               Int                  @id @default(autoincrement())
  Factura_ID               Int
  Producto_ID              Int
  /// Variante exacta vendida (null = producto lineal sin matriz).
  Variante_ID              Int?
  Cantidad                 Int
  Precio_Unitario          Decimal              @default(0.0000) @db.Decimal(18, 6)
  Costo_Unitario_Historico Decimal              @default(0.0000) @db.Decimal(18, 6)
  Subtotal                 Decimal?             @db.Decimal(18, 6)
  facturas                 facturas             @relation(fields: [Factura_ID], references: [Factura_ID], onDelete: Cascade, map: "FK_DetalleFactura_Facturas")
  productos                productos            @relation(fields: [Producto_ID], references: [Producto_ID], map: "FK_DetalleFactura_Productos")
  producto_variantes       producto_variantes?  @relation(fields: [Variante_ID], references: [Variante_ID], map: "FK_DetalleFactura_Variante")

  @@index([Factura_ID], map: "FK_DetalleFactura_Facturas")
  @@index([Producto_ID], map: "IDX_DetalleFacturas_Producto")
  @@index([Variante_ID], map: "IDX_DetalleFacturas_Variante")
}

model notas_entrega_entrada {
  Nota_ID               Int                     @id @default(autoincrement())
  Numero_Nota           String                  @unique(map: "Numero_Nota") @db.VarChar(50)
  Fecha_Recepcion       DateTime                @default(now()) @db.Timestamp(0)
  Total_Costo           Decimal                 @default(0.0000) @db.Decimal(18, 6)
  Estatus               String                  @default("Procesada") @db.VarChar(20)
  Proveedor_ID          Int
  Usuario_ID            Int
  // A-017: rastro de anulación/reversa (no destructiva). La nota original se
  // conserva; solo se marca Estatus='Anulada' y se registra quién/por qué.
  Anulada_Por           Int?
  Fecha_Anulacion       DateTime?               @db.Timestamp(0)
  Motivo_Anulacion      String?                 @db.VarChar(200)
  detalle_notas_entrega detalle_notas_entrega[]
  proveedores           proveedores             @relation(fields: [Proveedor_ID], references: [Proveedor_ID], map: "FK_Notas_Proveedores")
  usuarios              usuarios                @relation(fields: [Usuario_ID], references: [Usuario_ID], map: "FK_Notas_Usuarios")

  @@index([Proveedor_ID], map: "FK_Notas_Proveedores")
  @@index([Usuario_ID], map: "FK_Notas_Usuarios")
  @@index([Fecha_Recepcion], map: "IDX_Notas_Fecha")
  cuentas_por_pagar cuentas_por_pagar?
}

model detalle_notas_entrega {
  Detalle_Nota_ID       Int                   @id @default(autoincrement())
  Nota_ID               Int
  Producto_ID           Int
  Variante_ID           Int?
  Cantidad              Int
  Costo_Unitario        Decimal               @default(0.0000) @db.Decimal(18, 6)
  Subtotal_Costo        Decimal?              @db.Decimal(18, 6)
  notas_entrega_entrada notas_entrega_entrada @relation(fields: [Nota_ID], references: [Nota_ID], onDelete: Cascade, map: "FK_DetalleNota_Cabecera")
  productos             productos             @relation(fields: [Producto_ID], references: [Producto_ID], map: "FK_DetalleNota_Productos")
  // Trazabilidad de variante (A-016): la compra ya actualizaba stock/costo de
  // la variante, pero el detalle no lo conservaba. Opcional + onDelete SetNull
  // para preservar el histórico de compras aunque la variante sea eliminada.
  producto_variantes     producto_variantes?   @relation(fields: [Variante_ID], references: [Variante_ID], onDelete: SetNull, map: "FK_DetalleNota_Variante")

  @@index([Nota_ID], map: "FK_DetalleNota_Cabecera")
  @@index([Producto_ID], map: "IDX_DetalleNotas_Producto")
  @@index([Variante_ID], map: "IDX_DetalleNotas_Variante")
}

model pagos {
  Pago_ID     Int      @id @default(autoincrement())
  Factura_ID  Int
  Metodo_Pago String   @db.VarChar(50)
  Monto       Decimal  @db.Decimal(18, 6)
  Referencia  String?  @db.VarChar(50)
  // true → pago en divisas extranjeras (base del IGTF 3%)
  Es_Divisa   Boolean  @default(false)
  Tasa_Cambio Decimal? @db.Decimal(18, 6)
  Fecha_Pago  DateTime @default(now()) @db.Timestamp(0)
  facturas    facturas @relation(fields: [Factura_ID], references: [Factura_ID], onDelete: Cascade, map: "FK_Pagos_Facturas")

  @@index([Factura_ID], map: "FK_Pagos_Facturas")
}

model caja {
  Caja_ID        Int               @id @default(autoincrement())
  Nombre         String            @db.VarChar(100)
  Saldo_Inicial  Decimal           @default(0.0000) @db.Decimal(18, 6)
  Saldo_Actual   Decimal           @default(0.0000) @db.Decimal(18, 6)
  Fecha_Apertura DateTime          @default(now()) @db.Timestamp(0)
  // Estado del turno de caja: ABIERTA | CERRADA.
  // Cada jornada (turno) es una fila; se cierra la activa al hacer arqueo.
  Estado         String            @default("ABIERTA") @db.VarChar(20)
  Fecha_Cierre   DateTime?         @db.Timestamp(0)
  Activa         Boolean           @default(true)
  // Cajero que abrió el turno (trazabilidad). NULL si el usuario fue removido
  // (onDelete SetNull → los JOIN son seguros aunque falte el usuario).
  Usuario_ID     Int?
  movimientos    movimientos_caja[]
  usuarios       usuarios?         @relation(fields: [Usuario_ID], references: [Usuario_ID], onDelete: SetNull, map: "FK_Caja_Usuarios")

  @@index([Activa], map: "IDX_Caja_Activa")
}

// Movimientos (ingresos/egresos) de la caja. Monto_USD mantiene la
// denominación única del sistema; el Bs se deriva con Tasa_Cambio.
model movimientos_caja {
  Movimiento_ID Int      @id @default(autoincrement())
  Caja_ID       Int
  Tipo          String   @db.VarChar(20) // INGRESO | EGRESO
  Concepto      String   @db.VarChar(255)
  Metodo_Pago   String   @db.VarChar(50)
  Monto_USD     Decimal  @db.Decimal(18, 6)
  Tasa_Cambio   Decimal? @db.Decimal(18, 6)
  Referencia    String?  @db.VarChar(50)
  Origen_ID     Int?
  Origen_Tipo   String?  @db.VarChar(20) // factura | nota | manual
  Fecha         DateTime @default(now()) @db.Timestamp(0)
  // Usuario que registró el movimiento (trazabilidad). NULL si fue removido.
  Usuario_ID    Int?
  caja          caja     @relation(fields: [Caja_ID], references: [Caja_ID], map: "FK_MovCaja_Caja")
  usuarios      usuarios? @relation(fields: [Usuario_ID], references: [Usuario_ID], onDelete: SetNull, map: "FK_MovCaja_Usuarios")

  @@index([Caja_ID], map: "FK_MovCaja_Caja")
  @@index([Origen_Tipo, Origen_ID], map: "IDX_MovCaja_Origen")
}

// Cuentas por pagar a proveedores (compras a crédito).
// Nota_ID permite tracear la obligación a la nota de entrega de origen.
model cuentas_por_pagar {
  CxP_ID        Int                     @id @default(autoincrement())
  Proveedor_ID  Int
  Nota_ID       Int                     @unique(map: "UQ_CxP_Nota")
  Monto_Total   Decimal                 @db.Decimal(18, 6)
  Monto_Pagado  Decimal                 @default(0.0000) @db.Decimal(18, 6)
  Saldo         Decimal                 @db.Decimal(18, 6)
  Fecha         DateTime                @default(now()) @db.Timestamp(0)
  Vencimiento   DateTime?               @db.Timestamp(0)
  Estatus       String                  @default("Pendiente") @db.VarChar(20)
  proveedores   proveedores             @relation(fields: [Proveedor_ID], references: [Proveedor_ID], map: "FK_CxP_Proveedor")
  notas_entrega_entrada notas_entrega_entrada @relation(fields: [Nota_ID], references: [Nota_ID], map: "FK_CxP_Nota")

  @@index([Proveedor_ID], map: "FK_CxP_Proveedor")
  @@index([Estatus], map: "IDX_CxP_Estatus")
}

// ───────────────────────── Inventario Matricial (Tarea 5) ─────────────────
// ProductoVariante: fila por combinación de atributos (ej. Color=Gris,
// Talla=M). Un producto sin variantes opera a través de una variante
// "por defecto" idéntica al registro original (ver migrate_variantes).
model producto_variantes {
  Variante_ID    Int                 @id @default(autoincrement())
  Producto_ID    Int
  SKU_Variante   String              @unique(map: "UQ_Variante_SKU") @db.VarChar(60)
  Costo_Unitario Decimal             @default(0.0000) @db.Decimal(18, 6)
  Precio_Venta   Decimal             @default(0.0000) @db.Decimal(18, 6)
  // Margen específico de la variante. Null → hereda del producto padre (que
  // a su vez puede heredar de la categoría si el producto tampoco tiene).
  Margen_Ganancia Decimal?           @db.Decimal(18, 6)
  Stock_Actual   Int                 @default(0)
  Activo         Boolean             @default(true)
  Fecha_Registro DateTime            @default(now()) @db.Timestamp(0)
  productos      productos           @relation(fields: [Producto_ID], references: [Producto_ID], map: "FK_Variantes_Producto")
  atributos      variante_atributos[]
  detalle_facturas detalle_facturas[]
  detalle_notas_entrega detalle_notas_entrega[]

  @@index([Producto_ID], map: "IDX_Variantes_Producto")
}

// Atributo de una variante (par nombre/valor): ej. Atributo="Color", Valor="Gris".
model variante_atributos {
  Atributo_ID Int                @id @default(autoincrement())
  Variante_ID Int
  Atributo    String             @db.VarChar(50)
  Valor       String             @db.VarChar(60)
  variante    producto_variantes @relation(fields: [Variante_ID], references: [Variante_ID], onDelete: Cascade, map: "FK_VarAttr_Variante")

  @@unique([Variante_ID, Atributo], map: "UQ_VarAttr")
  @@index([Variante_ID], map: "IDX_VarAttr_Variante")
}

// Contadores secuenciales fiscales (nmero de control SENIAT).
// Cada fila guarda una serie: p.ej. Clave="CTRL-VENTAS-2026", Valor=n.
// El incremento es atómico (upsert + increment) dentro de la transacción de
// la factura, garantizando secuencia única sin huecos por carrera.
// Datos legales de la tienda (encabezado de facturas/tickets PDF).
// Una sola fila surtida por el seed; el backend aplica fallback si falta.
model configuracion_tienda {
  Config_ID   Int    @id @default(autoincrement())
  Nombre      String @db.VarChar(150)
  RIF         String @db.VarChar(20)
  Direccion   String @db.VarChar(255)
  Telefono    String @db.VarChar(25) @default("")
  /// Línea legal al pie del ticket/PDF (devoluciones, web, leyenda).
  Mensaje_Pie String @default("") @db.VarChar(255)
  /// Margen por defecto (%): punto de entrada de la cascada
  /// (Categoría > Tienda > 0). Se expone como margenDefecto en la API.
  Margen_Defecto Decimal @default(0.0000) @db.Decimal(18, 6)

  @@map("configuracion_tienda")
}

model contadores_fiscales {  Id    Int    @id @default(autoincrement())
  Clave String @unique(map: "UQ_Contadores_Clave") @db.VarChar(60)
  Valor Int    @default(0)
}

// Histórico de la tasa oficial BCV: una fila por jornada (Fecha es única).
// Fuente: microservicio Python-Scrappers (bcv.org.ve). El endpoint público
// /api/tasa-cambio persiste la tasa del día y usa la última registrada como
// fallback si el scraper no está disponible (nunca más placeholder fijo).
model tasas_bcv {
  Tasa_ID        Int      @id @default(autoincrement())
  Fecha          DateTime @unique(map: "UQ_TasasBcv_Fecha") @db.Date
  Tasa           Decimal  @db.Decimal(18, 6)
  Origen         String   @default("Banco Central de Venezuela") @db.VarChar(100)
  Fecha_Registro DateTime @default(now()) @db.Timestamp(0)
}

// Roles de usuario del sistema (Autorización en Caliente por PIN).
enum RolUsuario {
  CAJERO
  SUPERVISOR
  ADMIN
}