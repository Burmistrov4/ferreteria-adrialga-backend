generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categorias {
  Categoria_ID   Int         @id @default(autoincrement())
  Nombre         String      @db.VarChar(100)
  Prefijo_SKU    String      @default("GEN") @db.VarChar(3)
  Descripcion    String?     @db.VarChar(255)
  Activo         Boolean     @default(true)
  Fecha_Registro DateTime    @default(now()) @db.Timestamp(0)
  productos      productos[]
}

model clientes {
  Cliente_ID     Int        @id @default(autoincrement())
  RIF_Cedula     String     @unique(map: "RIF_Cedula") @db.VarChar(20)
  Tipo_Documento String     @default("V") @db.VarChar(1)
  Num_Documento  String     @default("") @db.VarChar(20)
  Razon_Social   String     @db.VarChar(150)
  Direccion      String?    @db.VarChar(255)
  Telefono       String?    @db.VarChar(20)
  Email          String?    @db.VarChar(100)
  Fecha_Registro DateTime   @default(now()) @db.Timestamp(0)
  facturas       facturas[]

  @@index([Num_Documento], map: "IDX_Clientes_NumDocumento")
  @@index([Razon_Social], map: "IDX_Clientes_RazonSocial")
}

model proveedores {
  Proveedor_ID          Int                     @id @default(autoincrement())
  RIF_Cedula            String                  @unique(map: "RIF_Cedula") @db.VarChar(20)
  Razon_Social          String                  @db.VarChar(150)
  Telefono              String?                 @db.VarChar(20)
  Email                 String?                 @db.VarChar(100)
  Direccion             String?                 @db.VarChar(255)
  Activo                Boolean                 @default(true)
  Fecha_Registro        DateTime                @default(now()) @db.Timestamp(0)
  notas_entrega_entrada notas_entrega_entrada[]
  cuentas_por_pagar     cuentas_por_pagar[]
}

model productos {
  Producto_ID           Int                     @id @default(autoincrement())
  SKU_Codigo            String                  @unique(map: "SKU_Codigo") @db.VarChar(50)
  Nombre                String                  @db.VarChar(150)
  Precio_Venta          Decimal                 @default(0.0000) @db.Decimal(18, 4)
  Costo_Promedio        Decimal                 @default(0.0000) @db.Decimal(18, 4)
  Stock_Actual          Int                     @default(0)
  Stock_Minimo          Int                     @default(5)
  Categoria_ID          Int
  Activo                Boolean                 @default(true)
  Fecha_Registro        DateTime                @default(now()) @db.Timestamp(0)
  detalle_facturas      detalle_facturas[]
  detalle_notas_entrega detalle_notas_entrega[]
  categorias            categorias              @relation(fields: [Categoria_ID], references: [Categoria_ID], map: "FK_Productos_Categorias")

  @@index([Categoria_ID], map: "IDX_Productos_Categoria")
}

model usuarios {
  Usuario_ID            Int                     @id @default(autoincrement())
  Nombre                String                  @db.VarChar(180)
  Credencial            String                  @unique(map: "Credencial") @db.VarChar(50)
  Password              String                  @db.VarChar(255)
  Rol                   String                  @default("Cajero") @db.VarChar(30)
  Activo                Boolean                 @default(true)
  Fecha_Registro        DateTime                @default(now()) @db.Timestamp(0)
  facturas              facturas[]
  notas_entrega_entrada notas_entrega_entrada[]
}

model facturas {
  Factura_ID       Int                @id @default(autoincrement())
  Numero_Control   String?            @unique(map: "Numero_Control") @db.VarChar(50)
  Fecha_Emision    DateTime           @default(now()) @db.Timestamp(0)
  Subtotal         Decimal            @default(0.0000) @db.Decimal(12, 4)
  Total_IVA        Decimal            @default(0.0000) @db.Decimal(12, 4)
  Total_General    Decimal            @default(0.0000) @db.Decimal(12, 4)
  // Tasa BCV histórica obligatoria usada al momento de la emisión (4 decimales).
  // Default temporal 1.0 para sincronización con Railway (rellena filas existentes).
  Tasa_Cambio      Decimal            @default(1.0) @db.Decimal(12, 4)
  Monto_IGTF       Decimal            @default(0.0000) @db.Decimal(12, 4)
  Estatus          String             @default("Completada") @db.VarChar(20)
  Cliente_ID       Int
  Usuario_ID       Int
  detalle_facturas detalle_facturas[]
  clientes         clientes           @relation(fields: [Cliente_ID], references: [Cliente_ID], map: "FK_Facturas_Clientes")
  usuarios         usuarios           @relation(fields: [Usuario_ID], references: [Usuario_ID], map: "FK_Facturas_Usuarios")
  pagos            pagos[]

  @@index([Cliente_ID], map: "FK_Facturas_Clientes")
  @@index([Usuario_ID], map: "FK_Facturas_Usuarios")
  @@index([Fecha_Emision], map: "IDX_Facturas_Fecha")
}

model detalle_facturas {
  Detalle_ID               Int       @id @default(autoincrement())
  Factura_ID               Int
  Producto_ID              Int
  Cantidad                 Int
  Precio_Unitario          Decimal   @default(0.0000) @db.Decimal(18, 4)
  Costo_Unitario_Historico Decimal   @default(0.0000) @db.Decimal(18, 4)
  Subtotal                 Decimal?  @db.Decimal(12, 4)
  facturas                 facturas  @relation(fields: [Factura_ID], references: [Factura_ID], onDelete: Cascade, map: "FK_DetalleFactura_Facturas")
  productos                productos @relation(fields: [Producto_ID], references: [Producto_ID], map: "FK_DetalleFactura_Productos")

  @@index([Factura_ID], map: "FK_DetalleFactura_Facturas")
  @@index([Producto_ID], map: "IDX_DetalleFacturas_Producto")
}

model notas_entrega_entrada {
  Nota_ID               Int                     @id @default(autoincrement())
  Numero_Nota           String                  @unique(map: "Numero_Nota") @db.VarChar(50)
  Fecha_Recepcion       DateTime                @default(now()) @db.Timestamp(0)
  Total_Costo           Decimal                 @default(0.0000) @db.Decimal(18, 4)
  Estatus               String                  @default("Procesada") @db.VarChar(20)
  Proveedor_ID          Int
  Usuario_ID            Int
  detalle_notas_entrega detalle_notas_entrega[]
  proveedores           proveedores             @relation(fields: [Proveedor_ID], references: [Proveedor_ID], map: "FK_Notas_Proveedores")
  usuarios              usuarios                @relation(fields: [Usuario_ID], references: [Usuario_ID], map: "FK_Notas_Usuarios")

  @@index([Proveedor_ID], map: "FK_Notas_Proveedores")
  @@index([Usuario_ID], map: "FK_Notas_Usuarios")
  @@index([Fecha_Recepcion], map: "IDX_Notas_Fecha")
  cuentas_por_pagar cuentas_por_pagar?
}

model detalle_notas_entrega {
  Detalle_Nota_ID       Int                   @id @default(autoincrement())
  Nota_ID               Int
  Producto_ID           Int
  Cantidad              Int
  Costo_Unitario        Decimal               @default(0.0000) @db.Decimal(18, 4)
  Subtotal_Costo        Decimal?              @db.Decimal(18, 4)
  notas_entrega_entrada notas_entrega_entrada @relation(fields: [Nota_ID], references: [Nota_ID], onDelete: Cascade, map: "FK_DetalleNota_Cabecera")
  productos             productos             @relation(fields: [Producto_ID], references: [Producto_ID], map: "FK_DetalleNota_Productos")

  @@index([Nota_ID], map: "FK_DetalleNota_Cabecera")
  @@index([Producto_ID], map: "IDX_DetalleNotas_Producto")
}

model pagos {
  Pago_ID     Int      @id @default(autoincrement())
  Factura_ID  Int
  Metodo_Pago String   @db.VarChar(50)
  Monto       Decimal  @db.Decimal(12, 4)
  Referencia  String?  @db.VarChar(50)
  // true → pago en divisas extranjeras (base del IGTF 3%)
  Es_Divisa   Boolean  @default(false)
  Tasa_Cambio Decimal? @db.Decimal(12, 4)
  Fecha_Pago  DateTime @default(now()) @db.Timestamp(0)
  facturas    facturas @relation(fields: [Factura_ID], references: [Factura_ID], onDelete: Cascade, map: "FK_Pagos_Facturas")

  @@index([Factura_ID], map: "FK_Pagos_Facturas")
}

model caja {
  Caja_ID        Int               @id @default(autoincrement())
  Nombre         String            @db.VarChar(100)
  Saldo_Inicial  Decimal           @default(0.0000) @db.Decimal(18, 4)
  Saldo_Actual   Decimal           @default(0.0000) @db.Decimal(18, 4)
  Fecha_Apertura DateTime          @default(now()) @db.Timestamp(0)
  Activa         Boolean           @default(true)
  movimientos    movimientos_caja[]

  @@index([Activa], map: "IDX_Caja_Activa")
}

// Movimientos (ingresos/egresos) de la caja. Monto_USD mantiene la
// denominación única del sistema; el Bs se deriva con Tasa_Cambio.
model movimientos_caja {
  Movimiento_ID Int      @id @default(autoincrement())
  Caja_ID       Int
  Tipo          String   @db.VarChar(20) // INGRESO | EGRESO
  Concepto      String   @db.VarChar(255)
  Metodo_Pago   String   @db.VarChar(50)
  Monto_USD     Decimal  @db.Decimal(18, 4)
  Tasa_Cambio   Decimal? @db.Decimal(12, 4)
  Referencia    String?  @db.VarChar(50)
  Origen_ID     Int?
  Origen_Tipo   String?  @db.VarChar(20) // factura | nota | manual
  Fecha         DateTime @default(now()) @db.Timestamp(0)
  caja          caja     @relation(fields: [Caja_ID], references: [Caja_ID], map: "FK_MovCaja_Caja")

  @@index([Caja_ID], map: "FK_MovCaja_Caja")
  @@index([Origen_Tipo, Origen_ID], map: "IDX_MovCaja_Origen")
}

// Cuentas por pagar a proveedores (compras a crédito).
// Nota_ID permite tracear la obligación a la nota de entrega de origen.
model cuentas_por_pagar {
  CxP_ID        Int                     @id @default(autoincrement())
  Proveedor_ID  Int
  Nota_ID       Int                     @unique(map: "UQ_CxP_Nota")
  Monto_Total   Decimal                 @db.Decimal(18, 4)
  Monto_Pagado  Decimal                 @default(0.0000) @db.Decimal(18, 4)
  Saldo         Decimal                 @db.Decimal(18, 4)
  Fecha         DateTime                @default(now()) @db.Timestamp(0)
  Vencimiento   DateTime?               @db.Timestamp(0)
  Estatus       String                  @default("Pendiente") @db.VarChar(20)
  proveedores   proveedores             @relation(fields: [Proveedor_ID], references: [Proveedor_ID], map: "FK_CxP_Proveedor")
  notas_entrega_entrada notas_entrega_entrada @relation(fields: [Nota_ID], references: [Nota_ID], map: "FK_CxP_Nota")

  @@index([Proveedor_ID], map: "FK_CxP_Proveedor")
  @@index([Estatus], map: "IDX_CxP_Estatus")
}